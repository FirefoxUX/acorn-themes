{
  "manifest_version": 3,
  "name": "Lagoon",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "nova-lagoon@mozilla.org"
    }
  },
  "theme": {
    "colors": {
      "frame": "#ECF3F8",
      "frame_inactive": "#D8DFE4",
      "toolbar": "#FFFFFF66",
      "toolbar_text": "#111524",
      "icons": "#23327B",
      "icons_attention": "#5A87FD",
      "toolbar_top_separator": "#00000000",
      "toolbar_bottom_separator": "#A2D3FF",
      "toolbar_vertical_separator": "#C5EAFE",
      "tab_selected": "#FFFFFF",
      "tab_text": "#111524",
      "tab_background_text": "#111524",
      "tab_line": "#7BB2FF",
      "tab_loading": "#7BB2FF",
      "tab_background_separator": "#00000029",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#111524",
      "toolbar_field_border": "#00000024",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#111524",
      "popup_highlight": "#5A87FD",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#FFFFFF",
      "sidebar_text": "#111524",
      "sidebar_border": "#A2D3FF",
      "button_background_hover": "#455FE740",
      "button_background_active": "#455FE773",
      "ntp_background": "#ECF3F8"
    },
    "images": {
      "additional_backgrounds": [
        {
          "linear-gradient": "135deg, #ECF3F8 0%, #C5EAFE 60%, #A2D3FF 100%"
        }
      ]
    },
    "properties": {
      "additional_backgrounds_tiling": [
        "no-repeat"
      ],
      "additional_backgrounds_size": [
        "auto"
      ],
      "backgrounds_area": "window"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#111524",
      "frame_inactive": "#050816",
      "toolbar": "#00000033",
      "toolbar_text": "#ECF3F8",
      "icons": "#ECF3F8",
      "icons_attention": "#5A87FD",
      "toolbar_bottom_separator": "#3246B0",
      "toolbar_vertical_separator": "#23327B",
      "tab_selected": "#111524",
      "tab_text": "#ECF3F8",
      "tab_background_text": "#ECF3F8",
      "tab_line": "#3246B0",
      "tab_loading": "#3246B0",
      "toolbar_field": "#111524",
      "toolbar_field_text": "#ECF3F8",
      "toolbar_field_border": "#23327B",
      "toolbar_field_focus": "#272429",
      "toolbar_field_text_focus": "#ECF3F8",
      "popup_highlight": "#455FE7",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#111524",
      "sidebar_text": "#ECF3F8",
      "sidebar_border": "#3246B0",
      "button_background_hover": "#7BB2FF66",
      "button_background_active": "#7BB2FF99",
      "ntp_background": "#111524"
    },
    "images": {
      "additional_backgrounds": [
        {
          "linear-gradient": "135deg, #23327B 0%, #17214C 60%, #111524 100%"
        }
      ]
    },
    "properties": {
      "additional_backgrounds_tiling": [
        "no-repeat"
      ],
      "additional_backgrounds_size": [
        "auto"
      ],
      "backgrounds_area": "window"
    }
  }
}
