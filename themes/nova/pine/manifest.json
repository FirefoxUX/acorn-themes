{
  "manifest_version": 3,
  "name": "Pine",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "nova-pine@mozilla.org"
    }
  },
  "theme": {
    "colors": {
      "frame": "#ECF4F1",
      "frame_inactive": "#D8E0DD",
      "toolbar": "#FFFFFF66",
      "toolbar_text": "#001E12",
      "icons": "#004933",
      "icons_attention": "#11AE84",
      "toolbar_top_separator": "#00000000",
      "toolbar_bottom_separator": "#90E3C6",
      "toolbar_vertical_separator": "#C4F1E0",
      "tab_selected": "#FFFFFF",
      "tab_text": "#001E12",
      "tab_background_text": "#001E12",
      "tab_line": "#4ACCA6",
      "tab_loading": "#4ACCA6",
      "tab_background_separator": "#00000029",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#001E12",
      "toolbar_field_border": "#00000024",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#001E12",
      "popup_highlight": "#11AE84",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#FFFFFF",
      "sidebar_text": "#001E12",
      "sidebar_border": "#90E3C6",
      "button_background_hover": "#00886540",
      "button_background_active": "#00886573",
      "ntp_background": "#ECF4F1"
    },
    "images": {
      "additional_backgrounds": [
        {
          "linear-gradient": "135deg, #ECF4F1 0%, #C4F1E0 60%, #90E3C6 100%"
        }
      ]
    },
    "properties": {
      "additional_backgrounds_tiling": [
        "no-repeat"
      ],
      "additional_backgrounds_size": [
        "auto"
      ],
      "backgrounds_area": "window"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#001E12",
      "frame_inactive": "#001006",
      "toolbar": "#00000033",
      "toolbar_text": "#ECF4F1",
      "icons": "#ECF4F1",
      "icons_attention": "#4ACCA6",
      "toolbar_bottom_separator": "#06674B",
      "toolbar_vertical_separator": "#003020",
      "tab_selected": "#001E12",
      "tab_text": "#ECF4F1",
      "tab_background_text": "#ECF4F1",
      "tab_line": "#06674B",
      "tab_loading": "#06674B",
      "toolbar_field": "#001E12",
      "toolbar_field_text": "#ECF4F1",
      "toolbar_field_border": "#003020",
      "toolbar_field_focus": "#272429",
      "toolbar_field_text_focus": "#ECF4F1",
      "popup_highlight": "#008865",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#001E12",
      "sidebar_text": "#ECF4F1",
      "sidebar_border": "#06674B",
      "button_background_hover": "#4ACCA666",
      "button_background_active": "#4ACCA699",
      "ntp_background": "#001E12"
    },
    "images": {
      "additional_backgrounds": [
        {
          "linear-gradient": "135deg, #004933 0%, #003020 60%, #001E12 100%"
        }
      ]
    },
    "properties": {
      "additional_backgrounds_tiling": [
        "no-repeat"
      ],
      "additional_backgrounds_size": [
        "auto"
      ],
      "backgrounds_area": "window"
    }
  }
}
