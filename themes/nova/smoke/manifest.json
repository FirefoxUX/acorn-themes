{
  "manifest_version": 3,
  "name": "Smoke",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "nova-smoke@mozilla.org"
    }
  },
  "theme": {
    "colors": {
      "frame": "#FBF4EE",
      "frame_inactive": "#E7E0DA",
      "toolbar": "#FFFFFF66",
      "toolbar_text": "#181310",
      "icons": "#2F2926",
      "icons_attention": "#8A837E",
      "toolbar_top_separator": "#00000000",
      "toolbar_bottom_separator": "#F5E7DB",
      "toolbar_vertical_separator": "#F5E7DB",
      "tab_selected": "#FFFFFF",
      "tab_text": "#181310",
      "tab_background_text": "#181310",
      "tab_line": "#D1CBC7",
      "tab_loading": "#BDB6B1",
      "tab_background_separator": "#00000029",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#181310",
      "toolbar_field_border": "#F8EFE6",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#181310",
      "popup_highlight": "#706964",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#FFFFFF",
      "sidebar_text": "#181310",
      "sidebar_border": "#F5E7DB",
      "button_background_hover": "#E3DBD7",
      "button_background_active": "#BDB6B1",
      "ntp_background": "#FFF9F6"
    },
    "images": {
      "additional_backgrounds": [
        {
          "linear-gradient": "135deg, #FFF9F6 0%, #FBF4EE 60%, #E3DBD7 100%"
        }
      ]
    },
    "properties": {
      "additional_backgrounds_tiling": [
        "no-repeat"
      ],
      "additional_backgrounds_size": [
        "auto"
      ],
      "backgrounds_area": "window"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#181310",
      "frame_inactive": "#0B0705",
      "toolbar": "#00000033",
      "toolbar_text": "#FFF9F6",
      "icons": "#FFF9F6",
      "icons_attention": "#BDB6B1",
      "toolbar_bottom_separator": "#59524F",
      "toolbar_vertical_separator": "#2F2926",
      "tab_selected": "#181310",
      "tab_text": "#FFF9F6",
      "tab_background_text": "#FFF9F6",
      "tab_line": "#59524F",
      "tab_loading": "#59524F",
      "toolbar_field": "#181310",
      "toolbar_field_text": "#FFF9F6",
      "toolbar_field_border": "#2F2926",
      "toolbar_field_focus": "#272429",
      "toolbar_field_text_focus": "#FFF9F6",
      "popup_highlight": "#8A837E",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#181310",
      "sidebar_text": "#FFF9F6",
      "sidebar_border": "#2F2926",
      "button_background_hover": "#59524F",
      "button_background_active": "#8A837E",
      "ntp_background": "#181310"
    },
    "images": {
      "additional_backgrounds": [
        {
          "linear-gradient": "135deg, #3B3532 0%, #2F2926 60%, #201B18 100%"
        }
      ]
    },
    "properties": {
      "additional_backgrounds_tiling": [
        "no-repeat"
      ],
      "additional_backgrounds_size": [
        "auto"
      ],
      "backgrounds_area": "window"
    }
  }
}
